# Copy to .env.local and fill in. Never commit .env.local.

# Spotify — from developer.spotify.com/dashboard; refresh token from `npm run spotify:auth`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steps — Upstash Redis (upstash.com, REST API section) and a random secret for the phone app.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STEPS_API_KEY=

# GitHub contributions tile — fine-grained token, read-only, public repositories only.
GITHUB_TOKEN=
